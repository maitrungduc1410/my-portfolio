---
import { useI18n, type Locale } from '../i18n';
interface Props { locale: Locale }
const { t } = useI18n(Astro.props.locale);
---

<div class="shint" id="sound-hint" role="dialog" aria-modal="false" aria-labelledby="sound-hint-t" hidden>
  <span class="shint__ic" aria-hidden="true">
    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6h2.5L8 3v10L4.5 10H2Z"/><path d="M10.5 5.8a3 3 0 0 1 0 4.4M12.4 4a5.6 5.6 0 0 1 0 8"/></svg>
  </span>
  <p class="shint__t" id="sound-hint-t">{t.soundHint.text}</p>
  <div class="shint__a">
    <button class="btn btn--p shint__play" type="button" data-hint="play">{t.soundHint.play}</button>
    <button class="btn shint__mute" type="button" data-hint="mute">{t.soundHint.mute}</button>
  </div>
  <button class="shint__x" type="button" data-hint="close" aria-label={t.soundHint.close}>
    <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg>
  </button>
</div>
